10 ON ERROR REPORT:PRINT:OSCLI "BYE"
20 PRINT "CASE 0,0"
30 IF 0 THEN IF 0 THEN PRINT "inner-yes" ELSE PRINT "inner-no" ELSE PRINT "outer-no"
40 PRINT "next"
50 PRINT "CASE 0,1"
60 IF 0 THEN IF 1 THEN PRINT "inner-yes" ELSE PRINT "inner-no" ELSE PRINT "outer-no"
70 PRINT "next"
80 PRINT "CASE 1,0"
90 IF 1 THEN IF 0 THEN PRINT "inner-yes" ELSE PRINT "inner-no" ELSE PRINT "outer-no"
100 PRINT "next"
110 PRINT "CASE 1,1"
120 IF 1 THEN IF 1 THEN PRINT "inner-yes" ELSE PRINT "inner-no" ELSE PRINT "outer-no"
130 PRINT "next"
140 IF .9 THEN PRINT "fraction-true" ELSE PRINT "fraction-false"
150 IF -.9 THEN PRINT "negative-true" ELSE PRINT "negative-false"
160 IF 0 THEN PRINT "no":PRINT "no" ELSE PRINT "yes":PRINT "yes"
170 IF 1 THEN PRINT "yes" ELSE PRINT "no" ELSE PRINT "no2"
180 IF 0 THEN
190 PRINT "bad"
200 ELSE PRINT "blockelse"
210 ENDIF
220 PRINT "CONDITIONAL_ORACLE_DONE":OSCLI "BYE"
