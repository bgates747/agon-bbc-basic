10 ON ERROR REPORT:PRINT:PRINT "FN_RIGHT_DONE":OSCLI "BYE"
20 PRINT "FNa"
30 PRINT ;LEN RIGHT$(FNa);":";ASC RIGHT$(FNa);":";ASC RIGHT$(FNa,1);":";ASC MID$(FNa,3)
40 PRINT "FNb(""ABC"")"
50 PRINT ;LEN RIGHT$(FNb("ABC"));":";ASC RIGHT$(FNb("ABC"));":";ASC RIGHT$(FNb("ABC"),1);":";ASC MID$(FNb("ABC"),3)
60 PRINT "FNc"
70 PRINT ;LEN RIGHT$(FNc);":";ASC RIGHT$(FNc);":";ASC RIGHT$(FNc,1);":";ASC MID$(FNc,3)
80 PRINT "FNd"
90 PRINT ;LEN RIGHT$(FNd);":";ASC RIGHT$(FNd);":";ASC RIGHT$(FNd,1);":";ASC MID$(FNd,3)
100 PRINT "FNe"
110 PRINT ;LEN RIGHT$(FNe);":";ASC RIGHT$(FNe);":";ASC RIGHT$(FNe,1);":";ASC MID$(FNe,3)
120 PRINT "FNa+"""""
130 PRINT ;LEN RIGHT$(FNa+"");":";ASC RIGHT$(FNa+"");":";ASC RIGHT$(FNa+"",1);":";ASC MID$(FNa+"",3)
140 PRINT "(FNa)"
150 PRINT ;LEN RIGHT$((FNa));":";ASC RIGHT$((FNa));":";ASC RIGHT$((FNa),1);":";ASC MID$((FNa),3)
160 PRINT "FNempty"
170 PRINT ;LEN RIGHT$(FNempty);":";ASC RIGHT$(FNempty);":";ASC RIGHT$(FNempty,1);":";ASC MID$(FNempty,3)
180 PRINT "FN_RIGHT_DONE":OSCLI "BYE"
1000 DEF FNa="ABC"
1010 DEF FNb(s$)=s$
1020 DEF FNc="A"+"BC"
1030 DEF FNd=CHR$(65)+CHR$(66)+CHR$(67)
1040 DEF FNe:LOCAL s$:s$="ABC":=s$
1050 DEF FNempty=""
