   1                       	; Native adapter probes: real unchanged NUM, observation bridges for MEM/ACT.
   2                       	    .assume adl=1
   3                       	    .text
   4                       	    .global entry
   5                       	    .extern cp_literal,cp_numeric,cp_read1,cp_read4,cp_read5
   6                       	    .extern cp_store1,cp_store4,cp_store5,cp_arrayprefix,cp_arrayaddr
   7                       	    .extern cp_actsave,cp_actbind,cp_actbegin
   8                       	    .extern cp_num_base,cp_str_base,cp_slot_numeric,cp_slot_numerror
   9                       	    .extern cp_slot_literal,cp_slot_novar,cp_slot_prefix,cp_slot_addr
  10                       	    .extern cp_slot_memerror,cp_slot_save,cp_slot_bind,cp_slot_begin,cp_slot_acterror
  11                       	    .extern rt_numeric,rt_literal
  12                       	    .macro patch field,value
  13                       	    ld hl,\value
  14                       	    ld (\field),hl               ; ADL24 OK: three-byte bridge field
  15                       	    .endm
  16                       	    .macro stage n
  17                       	    ld a,\n
  18                       	    ld (stage_value),a
  19                       	    .endm
  20                       	    .macro same value
  21                       	    ld de,\value
  22                       	    or a
  23                       	    sbc hl,de
  24                       	    jp nz,failed
  25                       	    .endm
  26                       	    .macro stack_ok
  27                       	    ld hl,0
  28                       	    add hl,sp
  29                       	    ld de,(saved_sp)             ; ADL24 OK: saved three-byte stack pointer
  30                       	    or a
  31                       	    sbc hl,de
  32                       	    jp nz,failed
  33                       	    .endm
  34                       	    .macro byte_at address,value
  35                       	    ld a,(\address)
  36                       	    cp \value
  37                       	    jp nz,failed
  38                       	    .endm
  39                       	    .macro same_packet address,expected
  40                       	    ld hl,\address
  41                       	    ld de,\expected
  42                       	    ld bc,5
  43                       	    call compare_bytes
  44                       	    .endm
