10 PRINT "C010_BEGIN"
20 REM PROGRAM TO DRAW MANDLEBROT SET
30 REM P.MAINWARING, MARCH 19TH 1990
40 :
50 MODE 8
60 ITERS=8
70 SCALE=64
80 XRANGE=-2.5
90 YRANGE=-1
100 DIM A%(3),B%(3)
110 :
120 FOR I%=0 TO 3
130   READ A%(I%),B%(I%)
140 NEXT
150 :
160 DATA 0,0,1,1,0,1,1,0
170 :
180 XSTP=1280/320
190 YSTP=1024/240
200 COLS=64
210 MAXX=1280
220 MAXY=1024
230 FOR I%=0 TO 3
240   FOR J%=A%(I%) TO MAXY/SCALE STEP YSTP
250     FOR K%=B%(I%) TO MAXX/SCALE STEP XSTP
260       CR=XRANGE+K%*4/(MAXX/SCALE)
270       CI=YRANGE+J%*3/(MAXX/SCALE)
280       ZM=0:ZR=0:ZI=0:ZR2=0:ZI2=0
290       IT=0
300       REPEAT
310         Z1=ZR2-ZI2+CR
320         Z2=2*ZR*ZI+CI
330         ZR=Z1
340         ZI=Z2
350         ZR2=ZR*ZR
360         ZI2=ZI*ZI
370         ZM=ZR2+ZI2
380         IT=IT+1
390       UNTIL IT=ITERS OR ZM>=4
400       C%=COLS-1-INT(IT/(ITERS/(COLS-1)))
410       GCOL 0,C%
420       PLOT 69,K%,J%
430     NEXT
440   NEXT
450 NEXT
460 PRINT "C010_WAIT":A%=GET
470 MODE 1
900 PRINT "C010_END"
910 END
