13000 DEF PROCsub_ticker REM 13000
13005 FOR R%=2 TO 18
13010   IF R%=9 OR R%=18 THEN GOTO 13040
13015   LTICK%(R%)=LTICK%(R%)+1
13020   EFFSPD%=LSPD%(R%)
13025   IF PANIC%=1 THEN EFFSPD%=LSPD%(R%)-2
13030   IF EFFSPD%<2 THEN EFFSPD%=2
13035   IF LTICK%(R%)>=EFFSPD% THEN PROCadvance_lane
13040 NEXT R%
13045 REM --- TURTLE DIVE TICKER ---
13050 FOR R%=2 TO 18
13055   IF LCH%(R%)<>226 THEN GOTO 13060 ELSE PROCturtle_dive
13060 NEXT R%
13065 IF INVTICK%>0 THEN INVTICK%=INVTICK%-1
13070 IF DONE%=0 THEN TL%=TL%-1
13075 PANIC%=0
13080 IF TL%<(TL_MAX%/4) THEN PANIC%=1
13085 SNTICK%=SNTICK%-1
13090 IF SNTICK%<=0 THEN PROCerase_snake:PROCplace_snake
13095 IF FLYSHOW%=1 THEN FLYTICK%=FLYTICK%-1:PROCdraw_fly
13100 IF FLYSHOW%=1 AND FLYTICK%<=0 THEN PROCdeactivate_fly
13105 IF FLYSHOW%=0 THEN FLYWAIT%=FLYWAIT%-1
13110 IF FLYSHOW%=0 AND FLYWAIT%<=0 THEN PROCactivate_fly
13115 IF LFACTIVE%=1 THEN LFTICK%=LFTICK%-1
13120 IF LFACTIVE%=1 AND LFTICK%<=0 THEN PROCerase_ladyfrog:PROCplace_ladyfrog
13125 IF CROCACTIVE%=1 THEN CROCTICK%=CROCTICK%-1
13130 IF CROCACTIVE%=1 AND CROCTICK%<=0 THEN PROCdeactivate_croc
13135 IF CROCACTIVE%=0 THEN CROCWAIT%=CROCWAIT%-1
13140 IF CROCACTIVE%=0 AND CROCWAIT%<=0 THEN PROCactivate_croc
13142 PROCshrink_tick
13145 WAVETICK%=WAVETICK%-1
13150 IF WAVETICK%<=0 THEN WAVETICK%=20:PROCwave_flip
13155 IF COMBOMSGTICK%=1 THEN PROCclear_combo_message
13160 IF COMBOMSGTICK%>0 THEN COMBOMSGTICK%=COMBOMSGTICK%-1
13165 IF TL%<=0 AND DONE%=0 THEN DTYPE%=0:PROCdie
13170 ENDPROC
13175 :
14000 DEF PROCturtle_dive REM 14000
14005 TTICK%(R%)=TTICK%(R%)-1
14010 IF TTICK%(R%)>0 THEN ENDPROC
14015 REM Timer expired - advance state
14020 IF TDIVE%(R%)=0 THEN TDIVE%(R%)=1:TTICK%(R%)=8:LREDRAW%(R%)=1:SOUND 3,-10,50,2:ENDPROC
14025 REM State 1: warning flash done - go submerged, erase turtles
14030 IF TDIVE%(R%)=1 THEN TDIVE%(R%)=2:TTICK%(R%)=25:PROCerase_turtles:ENDPROC
14035 REM State 2: submerged - resurface, kill frog if still on this row
14036 IF TDIVE%(R%)<>2 THEN GOTO 14050
14040 TDIVE%(R%)=3:TTICK%(R%)=8:LREDRAW%(R%)=1
14042 IF FY%=R% AND DONE%=0 THEN PROCdie
14045 ENDPROC
14050 REM State 3: resurface flash done - back to visible
14055 IF TDIVE%(R%)=3 THEN TDIVE%(R%)=0:TTICK%(R%)=80:LREDRAW%(R%)=1:ENDPROC
14060 ENDPROC
14070 :
