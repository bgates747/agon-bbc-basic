15020 REPEAT
15030   FOR PL%=1 TO 2:PSC%(PL%)=0:PLV%(PL%)=1:PLIV%(PL%)=3:PBON%(PL%)=0:PNH%(PL%)=0:PRSP%(PL%)=0:NEXT PL%
15032   FOR PL%=1 TO 2:FOR NG%=0 TO 4:PHF%(PL%,NG%)=0:NEXT NG%:NEXT PL%
15034   CURPL%=1
15040   REPEAT
15045     PROCload_player
15050     PROCinit_level
15060     PROCplay_level
15070     IF DONE%=1 THEN PROClevel_complete
15071     IF DONE%=1 AND LEVEL%=1 THEN PROCbonus_round
15072     IF DONE%=1 THEN LEVEL%=LEVEL%+1
15080     IF DONE%=2 THEN LIVES%=LIVES%-1:RESPAWN%=1
15082     PROCsave_player
15084     IF DONE%=2 AND NPLAYERS%=2 THEN PROCswitch_player
15090   UNTIL PLIV%(1)<=0 AND (NPLAYERS%=1 OR PLIV%(2)<=0)
15100   HPOS%=0
15110   PROCgame_over
15120 UNTIL PLAYAGAIN%=0
15130 MODE 8
15131 PROCthank_you
