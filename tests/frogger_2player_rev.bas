 8500 DEF PROCadvance_lane REM 8500
 8510 LTICK%(R%)=0
 8520 FOR O%=0 TO MAXO%-1
 8530   FOR S%=0 TO LLEN%(R%)-1
 8540     CX%=(LX%(R%,O%)+S%) MOD COLS%
 8550     PROCerase_obj_tile
 8560   NEXT S%
 8570 NEXT O%
 8580 FOR O%=0 TO MAXO%-1
 8590   LX%(R%,O%)=LX%(R%,O%)+LDIR%(R%)
 8592   IF LX%(R%,O%)<0 THEN LX%(R%,O%)=COLS%-1
 8594   IF LX%(R%,O%)>=COLS% THEN LX%(R%,O%)=0
 8596 NEXT O%
 8597 LREDRAW%(R%)=1
 8598 IF R%=FY% THEN movedThisFrame%=1
 8599 ENDPROC
 8600 DEF PROCriver_check REM 8600
 8605 REM If turtle row fully submerged, frog drowns immediately
 8606 IF LCH%(FY%)=226 AND TDIVE%(FY%)=2 THEN DTYPE%=1:PROCdie:ENDPROC
 8610 OLG%=0
 8620 FOR O%=0 TO MAXO%-1
 8630   FOR S%=0 TO LLEN%(FY%)-1
 8640     CX%=(LX%(FY%,O%)+S%) MOD COLS%
 8650     IF CX%=FX% THEN OLG%=1
 8660   NEXT S%
 8670 NEXT O%
 8672 REM --- SNAKE COLLISION CHECK ---
 8673 SNCX%=(LX%(SNROW%,SNOBJ%)+SNOFF%) MOD COLS%
 8674 IF FY%=SNROW% AND FX%=SNCX% AND OLG%=1 THEN DTYPE%=0:SOUND 3,-15,200,2:PROCdie:ENDPROC
 8675 REM Only drift if frog was already riding last frame (not just landed)
 8676 IF LFACTIVE%=0 OR LFCARRY%=1 THEN GOTO 8678
 8677 LFCX%=(LX%(LFROW%,LFOBJ%)+LFOFF%) MOD COLS%
 8678 IF FY%=LFROW% AND FX%=LFCX% AND OLG%=1 THEN LFCARRY%=1:SOUND 2,-15,180,2
 8680 IF OLG%=1 AND movedThisFrame%=1 AND PREVRVRFLAG%=1 THEN FX%=FX%+LDIR%(FY%)
 8690 IF OLG%=1 AND FX%<0 THEN PROCdie:ENDPROC
 8691 IF OLG%=1 AND FX%>COLS%-1 THEN PROCdie:ENDPROC
 8694 IF OLG%=0 THEN DTYPE%=1:PROCdie
 8696 ENDPROC
 8697 :
 8700 DEF PROCroad_check REM 8700
 8710 FOR O%=0 TO MAXO%-1
 8720   FOR S%=0 TO LLEN%(FY%)-1
 8730     CX%=(LX%(FY%,O%)+S%) MOD COLS%
 8740     IF CX%=FX% AND DONE%=0 THEN DTYPE%=0:PROCdie
 8750   NEXT S%
 8760 NEXT O%
 8770 ENDPROC
