 8000 DEF PROCplay_level REM 8000
 8010 DONE%=0
 8011 TIMEACC%=0:LASTSC%=-1:LASTLV%=-1:LASTLIVES%=-1:LASTTLBAR%=-1
 8012 movedThisFrame%=0
 8013 RVRFLAG%=0
 8015 LASTTIME%=TIME
 8020 REPEAT
 8022   REM --- STABLE 30 FPS GAME CLOCK BARRIER ---
 8024   REPEAT:oldup%=oldup% AND (INKEY(-58)<>0):olddown%=olddown% AND (INKEY(-42)<>0):oldleft%=oldleft% AND (INKEY(-26)<>0):oldright%=oldright% AND (INKEY(-122)<>0) UNTIL TIME >= LASTTIME% + 3
 8025   LASTTIME% = TIME
 8026   TIMEACC% = TIMEACC% + 1
 8027   LUPDATE% = 0
 8028   IF TIMEACC% >= 2 THEN LUPDATE% = 1:TIMEACC% = 0
 8029   movedThisFrame% = 0
 8030   SAVEFX%=FX%:SAVEFY%=FY%
 8040   REM Unconditional erase removed - gated on movement
 8050   IF DEMO%=1 THEN PROCdemo_move ELSE up%=INKEY(-58):down%=INKEY(-42):left%=INKEY(-26):right%=INKEY(-122)
 8065   NX%=FX%:NY%=FY%
 8070   IF up% AND NOT oldup% THEN NY%=FY%-1:FDIR%=0:NXU%=TIME+15
 8071   IF up% AND oldup% AND TIME>=NXU% THEN NY%=FY%-1:FDIR%=0:NXU%=TIME+15
 8075   IF down% AND NOT olddown% THEN NY%=FY%+1:FDIR%=1:NXD%=TIME+15
 8076   IF down% AND olddown% AND TIME>=NXD% THEN NY%=FY%+1:FDIR%=1:NXD%=TIME+15
 8080   IF left% AND NOT oldleft% THEN NX%=FX%-1:FDIR%=2:NXL%=TIME+15
 8081   IF left% AND oldleft% AND TIME>=NXL% THEN NX%=FX%-1:FDIR%=2:NXL%=TIME+15
 8085   IF right% AND NOT oldright% THEN NX%=FX%+1:FDIR%=3:NXR%=TIME+15
 8086   IF right% AND oldright% AND TIME>=NXR% THEN NX%=FX%+1:FDIR%=3:NXR%=TIME+15
 8090   oldup%=up%:olddown%=down%:oldleft%=left%:oldright%=right%
 8095   k$=INKEY$(0):IF k$="q" OR k$="Q" THEN DONE%=9
 8096   IF DEMO%=1 AND k$<>"" THEN DONE%=9
 8100   IF k$="p" OR k$="P" THEN PROCpause_game
 8130   IF NX%<0 THEN NX%=0
 8140   IF NX%>COLS%-1 THEN NX%=COLS%-1
 8150   IF NY%<HROW% THEN NY%=HROW%
 8160   IF NY%>BROW% THEN NY%=BROW%
 8165   IF (NX%<>FX% OR NY%<>FY%) AND DONE%=0 THEN PROCjump_sound
 8170   IF NY%<FY% AND DONE%=0 THEN SCORE%=SCORE%+10:SOUND 2,-15,220,1
 8171   IF NY%<FY% AND DONE%=0 THEN PROCcombo_hop
 8172   IF SCORE%>=20000 AND BONUSLIFE%=0 THEN LIVES%=LIVES%+1:BONUSLIFE%=1:PROCstatus_bar
 8173   IF SCORE%>=20000 AND BONUSLIFE%=1 AND LIVES%>3 THEN SOUND 0,-15,200,2:SOUND 1,-15,240,2
 8174   IF BONUSLIFE%=1 AND SCORE%>=20000 AND LIVES%>3 THEN COLOUR 128+0:COLOUR 10:PRINT TAB(9,22);"*** EXTRA LIFE! ***":PROCpause(60):PROCclear_message
 8175   REM Track whether frog was already on river before this move
 8176   PREVRVRFLAG%=RVRFLAG%
 8177   IF FNriver(NY%) THEN RVRFLAG%=1 ELSE RVRFLAG%=0
 8178   IF RVRFLAG%=1 AND PREVRVRFLAG%=0 THEN SOUND 3,-10,60,2
 8180   FX%=NX%:FY%=NY%
 8182   IF FY%>=RD1% AND FY%<=RD2% AND SAVEFY%<RD1% THEN SOUND 3,-10,80,1
 8183   IF FY%>=RD1% AND FY%<=RD2% AND SAVEFY%>RD2% THEN SOUND 3,-10,80,1
 8185   IF SAVEFX%<>FX% OR SAVEFY%<>FY% THEN FX%=SAVEFX%:FY%=SAVEFY%:PROCerase_frog:FX%=NX%:FY%=NY%:PROCdraw_frog:LASTMOVETIME%=TIME
 8186   REM --- RIVER/ROAD COLLISION (before objects move) ---
 8187   IF FNriver(FY%) AND DONE%=0 AND INVTICK%=0 THEN PROCriver_check
 8188   IF FY%>=RD1% AND FY%<=RD2% AND DONE%=0 AND INVTICK%=0 THEN PROCroad_check
 8189   IF FY%=HROW% AND DONE%=0 THEN PROChome_check
 8190   REM --- UPDATE GAME OBJECT TICKERS ---
 8191   IF LUPDATE%=1 THEN PROCsub_ticker
 8260   FOR R%=2 TO 18
 8270     IF R%=9 OR R%=18 OR LREDRAW%(R%)=0 THEN GOTO 8350
 8285     FG%=LCOL%(R%)
 8295     FOR O%=0 TO MAXO%-1
 8296       FOR S%=0 TO LLEN%(R%)-1
 8310         CX%=(LX%(R%,O%)+S%) MOD COLS%
 8320         PROCdraw_obj_tile
 8330       NEXT S%
 8340     NEXT O%
 8345     LREDRAW%(R%)=0
 8350   NEXT R%
 8351   REM --- DRAW SNAKE ON ITS LOG ---
 8352   SNCX%=(LX%(SNROW%,SNOBJ%)+SNOFF%) MOD COLS%
 8353   COLOUR 128+RIVERBG%:COLOUR 9:PRINT TAB(SNCX%,SNROW%);CHR$(238);
 8354   IF (TIME MOD 60)<30 THEN LFC%=13 ELSE LFC%=15
 8356   IF LFACTIVE%=1 AND LFCARRY%=0 THEN LFCX%=(LX%(LFROW%,LFOBJ%)+LFOFF%) MOD COLS%:COLOUR 128+RIVERBG%:COLOUR LFC%:PRINT TAB(LFCX%,LFROW%);CHR$(224);
 8357   PROCrestore_tile
 8370   IF FNriver(FY%) AND DONE%=0 AND INVTICK%=0 THEN PROCriver_check
 8390   IF FY%>=RD1% AND FY%<=RD2% AND DONE%=0 AND INVTICK%=0 THEN PROCroad_check
 8410   IF FY%=HROW% AND DONE%=0 THEN PROChome_check
 8460   IF DONE%=0 THEN PROCdraw_frog
 8470   PROCstatus_bar
 8490 UNTIL DONE%<>0
 8495 IF DONE%=9 THEN LIVES%=0:DONE%=2
 8496 ENDPROC
